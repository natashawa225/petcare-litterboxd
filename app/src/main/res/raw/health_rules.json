{
  "rules": [
    {
      "id": "urine_blockage_urgent",
      "type": "signal",
      "severity": "urgent",
      "windowDays": 2,
      "match": "any",
      "signals": [
        { "questionId": "litter", "value": "straining", "minDays": 1 },
        { "questionId": "urine_output", "value": "little_or_none", "minDays": 1 }
      ],
      "titleKey": "alert_urine_blockage_title",
      "messageKey": "alert_urine_blockage_message",
      "searchQuery": "straining to urinate",
      "searchTerms": ["strain", "urin"]
    },
    {
      "id": "drink_pee_weight",
      "type": "signal",
      "severity": "vet_visit",
      "windowDays": 7,
      "match": "all",
      "signals": [
        { "questionId": "water", "value": "more", "minDays": 3 },
        { "questionId": "urination_more", "value": "yes", "minDays": 2 }
      ],
      "requiresWeightDropKg": 0.3,
      "weightLookbackDays": 14,
      "titleKey": "alert_drink_pee_weight_title",
      "messageKey": "alert_drink_pee_weight_message",
      "supersedes": ["drink_and_pee"],
      "searchQuery": "drinking more urinating weight loss",
      "searchTerms": ["drink", "urin", "weight"]
    },
    {
      "id": "drink_and_pee",
      "type": "signal",
      "severity": "vet_visit",
      "windowDays": 7,
      "match": "all",
      "signals": [
        { "questionId": "water", "value": "more", "minDays": 3 },
        { "questionId": "urination_more", "value": "yes", "minDays": 2 }
      ],
      "titleKey": "alert_drink_pee_title",
      "messageKey": "alert_drink_pee_message",
      "searchQuery": "drinking more and urinating",
      "searchTerms": ["drink", "urin"]
    },
    {
      "id": "litter_and_drinking",
      "type": "signal",
      "severity": "vet_visit",
      "windowDays": 7,
      "match": "all",
      "signals": [
        { "questionId": "litter", "value": "more", "minDays": 3 },
        { "questionId": "drinking_more", "value": "yes", "minDays": 2 }
      ],
      "titleKey": "alert_litter_drink_title",
      "messageKey": "alert_litter_drink_message",
      "searchQuery": "litter tray drinking more",
      "searchTerms": ["litter", "drink"]
    },
    {
      "id": "low_appetite_vomiting",
      "type": "signal",
      "severity": "vet_visit",
      "windowDays": 7,
      "match": "all",
      "signals": [
        { "questionId": "appetite", "value": "less", "minDays": 3 },
        { "questionId": "vomiting", "value": "repeated", "minDays": 1 }
      ],
      "titleKey": "alert_appetite_vomit_title",
      "messageKey": "alert_appetite_vomit_message",
      "searchQuery": "loss of appetite vomiting",
      "searchTerms": ["appetite", "vomit"]
    },
    {
      "id": "litter_baseline_double",
      "type": "baseline",
      "severity": "watch",
      "windowDays": 7,
      "match": "all",
      "signals": [],
      "baselineQuestionId": "litter",
      "baselineValue": "more",
      "baselinePriorDays": 14,
      "baselineMinPriorLogged": 7,
      "baselineMinRecentLogged": 5,
      "baselineMinRatio": 2.0,
      "titleKey": "alert_litter_baseline_title",
      "messageKey": "alert_litter_baseline_message",
      "searchQuery": "litter tray visits",
      "searchTerms": ["litter"]
    },
    {
      "id": "water_rising_week",
      "type": "signal",
      "severity": "watch",
      "windowDays": 7,
      "match": "all",
      "signals": [
        { "questionId": "water", "value": "more", "minDays": 5 }
      ],
      "titleKey": "alert_water_rising_title",
      "messageKey": "alert_water_rising_message",
      "searchQuery": "increased thirst drinking",
      "searchTerms": ["drink"]
    },
    {
      "id": "hiding_week_plus",
      "type": "signal",
      "severity": "watch",
      "windowDays": 7,
      "match": "all",
      "signals": [
        { "questionId": "hiding_since", "value": "week_plus", "minDays": 1 }
      ],
      "titleKey": "alert_hiding_title",
      "messageKey": "alert_hiding_message",
      "searchQuery": "cat hiding",
      "searchTerms": ["hid"]
    }
  ]
}
