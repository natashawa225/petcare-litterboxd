<?xml version="1.0" encoding="utf-8"?>
<!-- Soft rounded pill behind the selected tab, inset so it doesn't touch the bar edges. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset
            android:insetLeft="@dimen/bottom_nav_pill_inset_horizontal"
            android:insetTop="@dimen/bottom_nav_pill_inset_vertical"
            android:insetRight="@dimen/bottom_nav_pill_inset_horizontal"
            android:insetBottom="@dimen/bottom_nav_pill_inset_vertical">
            <shape android:shape="rectangle">
                <solid android:color="@color/pastel_sage" />
                <corners android:radius="@dimen/bottom_nav_pill_radius" />
            </shape>
        </inset>
    </item>
    <item>
        <color android:color="@android:color/transparent" />
    </item>
</selector>
