<?xml version="1.0" encoding="utf-8"?>
<!-- Daily tab (default landing screen): greeting, selected cat, today's check-in, quick actions
     and a care-task summary. The shared bottom navigation sits below the scrolling content. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollDaily"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingEnd="@dimen/margin_horizontal"
            android:paddingBottom="@dimen/spacing_large">

            <!-- "Pet the cat" widget: greeting over the clip's empty top half, cats below.
                 Tap a cat to pet it; touch both cats with two fingers. See PetTheCatView. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPetTheCat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/pet_widget_background"
                app:cardCornerRadius="@dimen/pet_widget_corner"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextureView
                        android:id="@+id/texturePetTheCat"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="H,2:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/imgPetTheCatStill"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:importantForAccessibility="no"
                        android:scaleType="matrix"
                        android:src="@drawable/pet_the_cat_placeholder"
                        app:layout_constraintBottom_toBottomOf="@id/texturePetTheCat"
                        app:layout_constraintEnd_toEndOf="@id/texturePetTheCat"
                        app:layout_constraintStart_toStartOf="@id/texturePetTheCat"
                        app:layout_constraintTop_toTopOf="@id/texturePetTheCat" />

                    <TextView
                        android:id="@+id/tvWelcomeUser"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAppearance="@style/TextAppearance.Litterboxd.ScreenTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/texturePetTheCat" />

                    <TextView
                        android:id="@+id/tvDailyTagline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:text="@string/daily_greeting"
                        android:textAppearance="@style/TextAppearance.Litterboxd.Supporting"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvWelcomeUser" />

                    <!-- Transparent touch + hearts layer, on top of everything else. -->
                    <com.litterboxd.app.ui.home.PetTheCatView
                        android:id="@+id/petTheCatView"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/cd_pet_the_cat"
                        app:layout_constraintBottom_toBottomOf="@id/texturePetTheCat"
                        app:layout_constraintEnd_toEndOf="@id/texturePetTheCat"
                        app:layout_constraintStart_toStartOf="@id/texturePetTheCat"
                        app:layout_constraintTop_toTopOf="@id/texturePetTheCat" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

            <!-- My cats: swipeable row of cat cards + "Add cat" (built by CatCardRow).
                 Tap a cat to switch; tap the selected (lifted) cat for its profile. -->
            <TextView
                android:id="@+id/tvMyCatsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

            <HorizontalScrollView
                android:id="@+id/scrollMyCats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/my_cats_bleed"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginEnd="@dimen/my_cats_bleed"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/margin_horizontal"
                android:paddingEnd="@dimen/margin_horizontal"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutMyCats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvMyCatsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="@string/my_cats_hint"
                android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

            <!-- Today's check-in (CheckInActivity holds the form) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDailyLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:id="@+id/tvDailyLogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/daily_log_title"
                        android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

                    <TextView
                        android:id="@+id/tvDailyLogStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/daily_log_loading"
                        android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

                    <LinearLayout
                        android:id="@+id/layoutDailyLogAnswers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/layoutDailyReadings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/daily_readings_title"
                            android:textColor="@color/text_dark_gray"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layoutDailyReadingRows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogToday"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_card"
                        android:enabled="false"
                        android:text="@string/btn_log_today"
                        app:backgroundTint="@color/sage_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenHealthLog"
                        style="@style/Widget.Litterboxd.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:enabled="false"
                        android:text="@string/btn_open_health_log" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Health alerts (pattern rules + preset articles) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHealthAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/health_alerts_title"
                        android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

                    <TextView
                        android:id="@+id/tvHealthAlertsStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/daily_alerts_none"
                        android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenHealthAlerts"
                        style="@style/Widget.Litterboxd.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_card"
                        android:enabled="false"
                        android:text="@string/btn_open_health_alerts" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick actions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/quick_actions_title"
                android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickLog"
                    style="@style/Widget.Litterboxd.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:text="@string/btn_log_today"
                    app:icon="@drawable/ic_nav_daily" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickAddTask"
                    style="@style/Widget.Litterboxd.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:text="@string/btn_quick_add_task"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <!-- Today's care tasks: progress plus a tickable list (all tasks live on the Tasks tab) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTaskSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/daily_tasks_title"
                                android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

                            <TextView
                                android:id="@+id/tvTaskSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_tiny"
                                android:textColor="@color/dark_olive_green"
                                android:textSize="@dimen/text_size_small"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTodayReminder"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:textAllCaps="false"
                            android:paddingStart="@dimen/spacing_small"
                            android:paddingEnd="@dimen/spacing_small"
                            android:text="@string/daily_remind_button_off"
                            android:textColor="@color/sage_primary"
                            android:textSize="@dimen/text_size_caption" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressTasks"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:max="100"
                        android:progressTint="@color/sage_primary" />

                    <LinearLayout
                        android:id="@+id/layoutTodayTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeeTasks"
                        style="@style/Widget.Litterboxd.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_card"
                        android:text="@string/btn_see_tasks"
                        app:icon="@drawable/ic_nav_tasks" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
