<?xml version="1.0" encoding="utf-8"?>
<!-- Daily tab (default landing screen): greeting, selected cat, today's check-in, quick actions
     and a care-task summary. The shared bottom navigation sits below the scrolling content. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollDaily"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingEnd="@dimen/margin_horizontal"
            android:paddingBottom="@dimen/spacing_large">

            <!-- Greeting and date -->
            <TextView
                android:id="@+id/tvWelcomeUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="@string/daily_greeting"
                android:textAppearance="@style/TextAppearance.Litterboxd.ScreenTitle" />

            <TextView
                android:id="@+id/tvToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

            <!-- Selected cat -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSelectedCat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:cardBackgroundColor="@color/surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgHomeCatPhoto"
                            android:layout_width="@dimen/cat_avatar_size"
                            android:layout_height="@dimen/cat_avatar_size"
                            android:background="@color/white"
                            android:contentDescription="@string/title_cat_profile"
                            android:padding="@dimen/avatar_stroke"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Litterboxd.Circle"
                            app:srcCompat="@drawable/ic_cat_face"
                            app:strokeColor="@color/ink"
                            app:strokeWidth="@dimen/avatar_stroke" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_medium"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHomeCatName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_size_cat_name"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvHomeCatDetails"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSwitchCat"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/button_height"
                            android:text="@string/switch_cat"
                            android:textColor="@color/dark_olive_green"
                            android:textSize="@dimen/text_size_caption"
                            app:strokeColor="@color/sage_primary" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewCatProfile"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_card"
                        android:text="@string/nav_cat_profile"
                        app:backgroundTint="@color/sage_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Today's check-in (CheckInActivity holds the form) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDailyLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/daily_log_title"
                        android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

                    <TextView
                        android:id="@+id/tvDailyLogStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/daily_log_loading"
                        android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

                    <LinearLayout
                        android:id="@+id/layoutDailyLogAnswers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogToday"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_card"
                        android:enabled="false"
                        android:text="@string/btn_log_today"
                        app:backgroundTint="@color/sage_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick actions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/quick_actions_title"
                android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickLog"
                    style="@style/Widget.Litterboxd.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:text="@string/btn_log_today"
                    app:icon="@drawable/ic_nav_daily" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickAddTask"
                    style="@style/Widget.Litterboxd.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:text="@string/btn_quick_add_task"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <!-- Care-task summary (the full list lives on the Tasks tab) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTaskSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/daily_tasks_title"
                        android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

                    <TextView
                        android:id="@+id/tvTaskSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:textColor="@color/dark_olive_green"
                        android:textSize="@dimen/text_size_small"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressTasks"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:max="100"
                        android:progressTint="@color/sage_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeeTasks"
                        style="@style/Widget.Litterboxd.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_card"
                        android:text="@string/btn_see_tasks"
                        app:icon="@drawable/ic_nav_tasks" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
