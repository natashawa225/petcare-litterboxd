<?xml version="1.0" encoding="utf-8"?>
<!-- Daily tab (default landing screen), flat and minimal: greeting widget, cat row, then in order
     of importance today's check-in, a health-alerts row, today's tasks and the Reading Corner
     carousel. Each core section sits in an outlined card (the app's Card style), 32dp apart. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDaily"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingEnd="@dimen/margin_horizontal"
            android:paddingBottom="@dimen/daily_bottom_padding">

            <!-- "Pet the cat" widget: greeting over the clip's empty top half, cats below.
                 Tap a cat to pet it; touch both cats with two fingers. See PetTheCatView. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPetTheCat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/pet_widget_background"
                app:cardCornerRadius="@dimen/pet_widget_corner"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextureView
                        android:id="@+id/texturePetTheCat"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintDimensionRatio="H,2:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/imgPetTheCatStill"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:importantForAccessibility="no"
                        android:scaleType="matrix"
                        android:src="@drawable/pet_the_cat_placeholder"
                        app:layout_constraintBottom_toBottomOf="@id/texturePetTheCat"
                        app:layout_constraintEnd_toEndOf="@id/texturePetTheCat"
                        app:layout_constraintStart_toStartOf="@id/texturePetTheCat"
                        app:layout_constraintTop_toTopOf="@id/texturePetTheCat" />

                    <TextView
                        android:id="@+id/tvWelcomeUser"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAppearance="@style/TextAppearance.Litterboxd.ScreenTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/texturePetTheCat" />

                    <TextView
                        android:id="@+id/tvDailyTagline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:text="@string/daily_greeting"
                        android:textAppearance="@style/TextAppearance.Litterboxd.Supporting"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvWelcomeUser" />

                    <!-- Transparent touch + hearts layer, on top of everything else. -->
                    <com.litterboxd.app.ui.home.PetTheCatView
                        android:id="@+id/petTheCatView"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:contentDescription="@string/cd_pet_the_cat"
                        app:layout_constraintBottom_toBottomOf="@id/texturePetTheCat"
                        app:layout_constraintEnd_toEndOf="@id/texturePetTheCat"
                        app:layout_constraintStart_toStartOf="@id/texturePetTheCat"
                        app:layout_constraintTop_toTopOf="@id/texturePetTheCat" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvToday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

            <!-- Cats: swipeable row (CatCardRow). Tap a cat to switch; the selected cat opens its
                 profile. No heading or hint: the avatars and names say what this is. -->
            <HorizontalScrollView
                android:id="@+id/scrollMyCats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/my_cats_bleed"
                android:layout_marginTop="@dimen/spacing_medium"
                android:layout_marginEnd="@dimen/my_cats_bleed"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/margin_horizontal"
                android:paddingEnd="@dimen/margin_horizontal"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutMyCats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 1. Today's check-in: the primary daily action, first. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDailyLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/daily_section_gap"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDailyLogTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/daily_log_title"
                            android:textAppearance="@style/TextAppearance.Litterboxd.DailyHeading" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenHealthLog"
                            style="@style/Widget.Litterboxd.TextLink"
                            android:enabled="false"
                            android:text="@string/daily_link_calendar" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDailyLogStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="@string/daily_log_loading"
                        android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

                    <LinearLayout
                        android:id="@+id/layoutDailyLogAnswers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogToday"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:enabled="false"
                        android:text="@string/btn_log_today"
                        app:backgroundTint="@color/sage_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Health alerts: one slim tappable row in its own card. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHealthAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/daily_section_gap"
                app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:id="@+id/btnOpenHealthAlerts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:enabled="false"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/button_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/card_padding"
                        android:paddingTop="@dimen/spacing_small"
                        android:paddingEnd="@dimen/card_padding"
                        android:paddingBottom="@dimen/spacing_small">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/health_alerts_title"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHealthAlertsStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:text="@string/daily_alerts_none"
                            android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="@dimen/spacing_tiny"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Today's tasks: checklist; "All tasks" opens the Tasks tab. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTaskSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/daily_section_gap"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/daily_tasks_title"
                            android:textAppearance="@style/TextAppearance.Litterboxd.DailyHeading" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSeeTasks"
                            style="@style/Widget.Litterboxd.TextLink"
                            android:text="@string/daily_link_all_tasks" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTaskSummary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTodayReminder"
                            style="@style/Widget.Litterboxd.TextLink"
                            android:text="@string/daily_remind_button_off" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressTasks"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:max="100"
                        android:progressTint="@color/sage_primary" />

                    <LinearLayout
                        android:id="@+id/layoutTodayTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Reading Corner, last and quiet: a horizontal carousel, so any number of
                 articles costs one row of height. "For you" (from today's log) comes first. -->
            <TextView
                android:id="@+id/tvReadingCornerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/daily_section_gap"
                android:text="@string/reading_corner_title_plain"
                android:textAppearance="@style/TextAppearance.Litterboxd.DailyHeading" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerReadingCorner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/my_cats_bleed"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginEnd="@dimen/my_cats_bleed"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/margin_horizontal"
                android:paddingEnd="@dimen/margin_horizontal" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
