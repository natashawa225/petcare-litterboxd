<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/tvArticleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

        <TextView
            android:id="@+id/tvArticleSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:textColor="@color/sage_primary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvArticleSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReadMore"
            style="@style/Widget.Litterboxd.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_card"
            android:text="@string/btn_read_more_article" />

        <LinearLayout
            android:id="@+id/layoutCitation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_card"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCitationLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

            <TextView
                android:id="@+id/tvCitationUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:textColor="@color/sage_primary"
                android:textSize="@dimen/text_size_caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenCited"
                style="@style/Widget.Litterboxd.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="@string/btn_open_cited_page" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
