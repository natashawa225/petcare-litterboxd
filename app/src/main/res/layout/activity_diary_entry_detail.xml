<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only view of one diary entry (DiaryEntryDetailActivity): a top bar with Back and Edit,
     the photo in a rounded 4:5 frame, then the type chip, date, title and the story text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_small"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingEnd="@dimen/margin_horizontal"
        android:paddingBottom="@dimen/spacing_small">

        <ImageButton
            android:id="@+id/btnDiaryDetailBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:rotation="180"
            android:src="@drawable/ic_chevron_right" />

        <TextView
            android:id="@+id/tvDiaryDetailCat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiaryDetailEdit"
            style="@style/Widget.Litterboxd.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/btn_edit" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/daily_bottom_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_horizontal"
            android:paddingEnd="@dimen/margin_horizontal">

            <!-- Photo: a fixed 4:5 frame (portrait, like most phone photos) so the layout never
                 jumps; centerCrop fills it neatly. Tap to switch to fitCenter and see it whole. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutDiaryDetailPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:cardBackgroundColor="@color/card_oat"
                    app:cardCornerRadius="@dimen/diary_detail_photo_corner"
                    app:cardElevation="0dp"
                    app:layout_constraintDimensionRatio="4:5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/ink"
                    app:strokeWidth="2dp">

                    <ImageView
                        android:id="@+id/imgDiaryDetailPhoto"
                        android:contentDescription="@string/cd_diary_detail_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Type chip + date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDiaryDetailType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDiaryDetailDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDiaryDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:fontFamily="@font/title_font"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/black"
                android:textSize="@dimen/diary_detail_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDiaryDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:lineSpacingMultiplier="1.45"
                android:textColor="@color/ink"
                android:textIsSelectable="true"
                android:textSize="@dimen/diary_detail_body_size" />

            <TextView
                android:id="@+id/tvDiaryDetailTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/sage_primary"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
