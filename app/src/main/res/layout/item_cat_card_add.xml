<?xml version="1.0" encoding="utf-8"?>
<!-- Last card in the Daily "My cats" row: dashed outline, opens AddEditCatActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/cat_card_add_width"
    android:layout_height="@dimen/cat_card_height"
    android:background="@drawable/bg_cat_card_add"
    android:clickable="true"
    android:contentDescription="@string/add_cat"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_add"
        app:tint="@color/ink" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:importantForAccessibility="no"
        android:text="@string/add_cat"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_small"
        android:textStyle="bold" />
</LinearLayout>
