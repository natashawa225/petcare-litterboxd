<?xml version="1.0" encoding="utf-8"?>
<!-- Edit the owner's display name and avatar (bundled illustration, own photo, or default). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layoutEditProfileActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingEnd="@dimen/margin_horizontal"
            android:paddingBottom="@dimen/spacing_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_profile_title"
                android:textAppearance="@style/TextAppearance.Litterboxd.ScreenTitle" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgAvatarPreview"
                android:layout_width="@dimen/owner_avatar_preview_size"
                android:layout_height="@dimen/owner_avatar_preview_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_large"
                android:contentDescription="@string/cd_owner_avatar"
                android:padding="@dimen/avatar_stroke"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Litterboxd.Circle"
                app:srcCompat="@drawable/ic_default_owner_avatar"
                app:strokeColor="@color/ink"
                app:strokeWidth="@dimen/avatar_stroke" />

            <ProgressBar
                android:id="@+id/progressAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOwnerDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:counterEnabled="true"
                app:counterMaxLength="@integer/max_owner_name_length">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOwnerDisplayName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/edit_profile_name_hint"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="@integer/max_owner_name_length"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/edit_profile_choose_avatar"
                android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

            <GridLayout
                android:id="@+id/gridAvatars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:columnCount="@integer/avatar_grid_columns" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadPhoto"
                style="@style/Widget.Litterboxd.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/btn_upload_photo"
                app:icon="@drawable/ic_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUseDefaultAvatar"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:minHeight="@dimen/button_height"
                android:text="@string/btn_use_default_avatar"
                android:textColor="@color/dark_olive_green" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutEditProfileActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelProfile"
            style="@style/Widget.Litterboxd.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/btn_save"
            app:backgroundTint="@color/sage_primary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
