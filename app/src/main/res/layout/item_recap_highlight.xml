<?xml version="1.0" encoding="utf-8"?>
<!-- The Health recap's one highlight: a soft tinted callout (tint set in HealthRecapCardView)
     with a small icon and a short plain-words sentence. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:background="@drawable/bg_recap_callout"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/imgHighlightIcon"
        android:layout_width="@dimen/recap_highlight_icon_size"
        android:layout_height="@dimen/recap_highlight_icon_size"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvHighlight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_small" />
</LinearLayout>
