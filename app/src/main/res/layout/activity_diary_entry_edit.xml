<?xml version="1.0" encoding="utf-8"?>
<!-- Add or edit a diary entry. Quick path for a memory: photo, short title, Save. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layoutDiaryEditActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingEnd="@dimen/margin_horizontal"
            android:paddingBottom="@dimen/spacing_medium">

            <TextView
                android:id="@+id/tvDiaryEditTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diary_new_title"
                android:textAppearance="@style/TextAppearance.Litterboxd.ScreenTitle" />

            <TextView
                android:id="@+id/tvDiaryEditCat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

            <!-- Entry type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeMemory"
                    style="@style/Widget.Litterboxd.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:text="@string/diary_type_memory"
                    app:icon="@drawable/ic_cat_face"
                    app:iconTint="@color/black" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTypeMilestone"
                    style="@style/Widget.Litterboxd.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:text="@string/diary_type_milestone"
                    app:icon="@drawable/ic_star"
                    app:iconTint="@color/black" />
            </LinearLayout>

            <!-- Photo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgDiaryEntryPhoto"
                android:layout_width="match_parent"
                android:layout_height="@dimen/diary_photo_preview_height"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@color/pastel_sage"
                android:padding="@dimen/avatar_stroke"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Litterboxd.DiaryPhoto"
                app:strokeColor="@color/ink"
                app:strokeWidth="@dimen/avatar_stroke" />

            <ProgressBar
                android:id="@+id/progressDiaryPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_small"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickDiaryPhoto"
                    style="@style/Widget.Litterboxd.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="@string/btn_add_photo"
                    app:icon="@drawable/ic_add" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemoveDiaryPhoto"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:minHeight="@dimen/button_height"
                    android:text="@string/btn_remove_photo"
                    android:textColor="@color/dark_olive_green"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDiaryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                app:counterEnabled="true"
                app:counterMaxLength="@integer/diary_title_max_length"
                app:errorEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDiaryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/diary_title_hint"
                    android:inputType="textCapSentences"
                    android:maxLength="@integer/diary_title_max_length"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDiaryCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/diary_caption_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="@integer/diary_caption_max_length"
                    android:maxLines="6" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiaryDate"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_medium"
                app:strokeColor="@color/sage_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/diary_tags_label"
                android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

            <GridLayout
                android:id="@+id/gridDiaryTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:columnCount="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteDiaryEntry"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_medium"
                android:minHeight="@dimen/button_height"
                android:text="@string/btn_delete_entry"
                android:textColor="@color/error_red"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutDiaryEditActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="@dimen/margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDiaryEntry"
            style="@style/Widget.Litterboxd.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveDiaryEntry"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:text="@string/btn_save"
            app:backgroundTint="@color/sage_primary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
