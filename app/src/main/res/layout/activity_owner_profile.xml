<?xml version="1.0" encoding="utf-8"?>
<!-- Profile tab: the owner's avatar and name, then My cats / Preferences / Data sections. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollProfile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margin_horizontal"
            android:paddingTop="@dimen/screen_padding_top"
            android:paddingEnd="@dimen/margin_horizontal"
            android:paddingBottom="@dimen/spacing_large">

            <!-- Header -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgOwnerAvatar"
                        android:layout_width="@dimen/owner_avatar_size"
                        android:layout_height="@dimen/owner_avatar_size"
                        android:contentDescription="@string/cd_owner_avatar"
                        android:padding="@dimen/avatar_stroke"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Litterboxd.Circle"
                        app:srcCompat="@drawable/ic_default_owner_avatar"
                        app:strokeColor="@color/ink"
                        app:strokeWidth="@dimen/avatar_stroke" />

                    <TextView
                        android:id="@+id/tvOwnerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_card"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Litterboxd.ScreenTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:gravity="center"
                        android:text="@string/profile_subtitle"
                        android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfile"
                        style="@style/Widget.Litterboxd.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:paddingStart="@dimen/spacing_large"
                        android:paddingEnd="@dimen/spacing_large"
                        android:text="@string/btn_edit_profile" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- My cats -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/profile_section_cats"
                android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_ink"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/rowManageCats"
                        layout="@layout/item_profile_row" />

                    <include
                        android:id="@+id/rowAddCat"
                        layout="@layout/item_profile_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Preferences -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/profile_section_preferences"
                android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_ink"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/rowNotifications"
                        layout="@layout/item_profile_row" />

                    <include
                        android:id="@+id/rowAbout"
                        layout="@layout/item_profile_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Data -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/profile_section_data"
                android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_ink"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/rowSampleData"
                        layout="@layout/item_profile_row" />

                    <include
                        android:id="@+id/rowResetApp"
                        layout="@layout/item_profile_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
