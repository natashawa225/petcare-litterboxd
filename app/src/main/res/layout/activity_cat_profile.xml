<?xml version="1.0" encoding="utf-8"?>
<!-- Cat profile: a header card (photo, name, age pill, health status, three stats), then
     weight and feeding cards. Pill colours and status text are set in CatProfileActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="@dimen/margin_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ===== Header card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/profile_card_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- Photo + name column -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfilePhoto"
                        android:layout_width="@dimen/profile_photo_size"
                        android:layout_height="@dimen/profile_photo_size"
                        android:background="@color/card_oat"
                        android:padding="@dimen/avatar_stroke"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Litterboxd.Circle"
                        app:srcCompat="@drawable/ic_cat_face"
                        app:strokeColor="@color/ink"
                        app:strokeWidth="@dimen/avatar_stroke" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvProfileName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/title_font"
                                android:maxLines="1"
                                android:textColor="@color/black"
                                android:textSize="@dimen/profile_name_size"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btnProfileMenu"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/cd_profile_menu"
                                android:src="@drawable/ic_more_vert" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvProfileDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Litterboxd.Supporting" />

                        <TextView
                            android:id="@+id/tvProfileAgePill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_small"
                            android:paddingStart="12dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/muted_pinkish_brown"
                            android:textSize="@dimen/text_size_small"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Health status: tap for the alerts screen. Never says "healthy" (no diagnosis). -->
                <LinearLayout
                    android:id="@+id/cardHealthStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvHealthStatusIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHealthStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_size_subtitle"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvHealthStatusSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_dark_gray"
                            android:textSize="@dimen/text_size_small" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <!-- Three stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_profile_stats"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Litterboxd.ProfileStatLabel"
                            android:text="@string/profile_stat_weight" />

                        <TextView
                            android:id="@+id/tvStatWeight"
                            style="@style/Litterboxd.ProfileStatValue" />

                        <TextView
                            android:id="@+id/tvStatWeightPill"
                            style="@style/Litterboxd.ProfileStatPill" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Litterboxd.ProfileStatLabel"
                            android:text="@string/profile_stat_logged" />

                        <TextView
                            android:id="@+id/tvStatLogged"
                            style="@style/Litterboxd.ProfileStatValue" />

                        <TextView
                            android:id="@+id/tvStatLoggedPill"
                            style="@style/Litterboxd.ProfileStatPill" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Litterboxd.ProfileStatLabel"
                            android:text="@string/profile_stat_lifestyle" />

                        <TextView
                            android:id="@+id/tvStatLifestyle"
                            style="@style/Litterboxd.ProfileStatValue" />

                        <TextView
                            android:id="@+id/tvStatLifestylePill"
                            style="@style/Litterboxd.ProfileStatPill" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Weight card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/profile_card_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_weight_history"
                        android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWeightHistory"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/btn_weight_history"
                        android:textColor="@color/sage_primary" />
                </LinearLayout>

                <com.litterboxd.app.ui.profile.WeightChartView
                    android:id="@+id/weightChart"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/card_oat"
                    android:padding="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvWeightChartHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/weight_chart_hint"
                    android:textColor="@color/text_dark_gray"
                    android:textSize="@dimen/text_size_caption"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/containerWeightLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddWeight"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_add_weight"
                    app:backgroundTint="@color/sage_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Feeding card ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/profile_card_corner">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_feeding_schedule"
                    android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

                <LinearLayout
                    android:id="@+id/containerFeedingMeals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditSchedule"
                    style="@style/Widget.Litterboxd.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_edit_schedule" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
