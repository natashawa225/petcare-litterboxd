<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/margin_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/onboarding_step_2"
            android:textColor="@color/text_dark_gray"
            android:textSize="@dimen/text_size_small" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_add_cat"
            android:textColor="@color/sage_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <!-- Photo & Avatar Selection Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgCatPhoto"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/btn_select_photo"
                android:padding="@dimen/avatar_stroke"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Litterboxd.Circle"
                app:srcCompat="@drawable/ic_cat_face"
                app:strokeColor="@color/ink"
                app:strokeWidth="@dimen/avatar_stroke" />

            <ProgressBar
                android:id="@+id/progressAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/edit_profile_choose_avatar"
                android:textAppearance="@style/TextAppearance.Litterboxd.SectionTitle" />

            <GridLayout
                android:id="@+id/gridAvatars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="@integer/avatar_grid_columns" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectPhoto"
                style="@style/Widget.Litterboxd.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="16dp"
                android:text="@string/btn_upload_photo"
                app:icon="@drawable/ic_add" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUseDefaultAvatar"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:minHeight="@dimen/button_height"
                android:text="@string/btn_use_default_avatar"
                android:textColor="@color/dark_olive_green" />
        </LinearLayout>

        <!-- Cat Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCatName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCatName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/prompt_cat_name"
                android:inputType="textPersonName"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Age Type RadioGroup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_age_type"
            android:textColor="@color/text_dark_gray"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgAgeType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbBirthday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/radio_birthday"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/rbApproxAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/radio_approx_age"
                android:textColor="@color/black" />
        </RadioGroup>

        <!-- Birthday Layout -->
        <LinearLayout
            android:id="@+id/layoutBirthday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectBirthday"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="@string/btn_select_birthday"
                app:strokeColor="@color/sage_primary" />
        </LinearLayout>

        <!-- Approximate Age Layout -->
        <LinearLayout
            android:id="@+id/layoutApproxAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prompt_years"
                    android:textColor="@color/text_dark_gray" />

                <Spinner
                    android:id="@+id/spinnerYears"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prompt_months"
                    android:textColor="@color/text_dark_gray" />

                <Spinner
                    android:id="@+id/spinnerMonths"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height" />
            </LinearLayout>
        </LinearLayout>

        <!-- Breed Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/prompt_cat_breed"
            android:textColor="@color/text_dark_gray"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerBreed"
            android:entries="@array/cat_breeds"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="4dp" />

        <!-- Sex RadioGroup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/prompt_cat_sex"
            android:textColor="@color/text_dark_gray"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/sex_female"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/sex_male"
                android:textColor="@color/black" />
        </RadioGroup>

        <!-- Neutered RadioGroup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/prompt_cat_neutered"
            android:textColor="@color/text_dark_gray"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgNeutered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbNeuteredYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/btn_yes"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/rbNeuteredNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/btn_no"
                android:textColor="@color/black" />
        </RadioGroup>

        <!-- Weight -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/prompt_cat_weight"
                android:digits="@string/decimal_digits"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Coat Color Swatches -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/prompt_coat_color"
            android:textColor="@color/text_dark_gray"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgCoatColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton android:id="@+id/rbColorBlack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/color_black" android:textColor="@color/black" />
            <RadioButton android:id="@+id/rbColorWhite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/color_white" android:textColor="@color/black" />
            <RadioButton android:id="@+id/rbColorOrange" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/color_ginger" android:textColor="@color/black" />
            <RadioButton android:id="@+id/rbColorGrey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/color_grey" android:textColor="@color/black" />
            <RadioButton android:id="@+id/rbColorCalico" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/color_calico" android:textColor="@color/black" />
            <RadioButton android:id="@+id/rbColorTabby" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/color_tabby" android:textColor="@color/black" />
        </RadioGroup>

        <!-- Lifestyle RadioGroup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/prompt_cat_lifestyle"
            android:textColor="@color/text_dark_gray"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgLifestyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbLifestyleIndoor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/lifestyle_indoor"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/rbLifestyleOutdoor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lifestyle_outdoor"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/rbLifestyleBoth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lifestyle_indoor_outdoor"
                android:textColor="@color/black" />
        </RadioGroup>

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Continue / Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCat"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="24dp"
            android:text="@string/btn_continue"
            app:backgroundTint="@color/sage_primary"
            app:cornerRadius="@dimen/corner_radius" />

    </LinearLayout>
</ScrollView>
