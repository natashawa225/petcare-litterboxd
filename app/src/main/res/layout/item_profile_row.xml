<?xml version="1.0" encoding="utf-8"?>
<!-- One tappable row in a Profile section: title, optional summary, chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/card_padding"
    android:paddingTop="@dimen/spacing_small"
    android:paddingEnd="@dimen/spacing_small"
    android:paddingBottom="@dimen/spacing_small">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_body" />

        <TextView
            android:id="@+id/tvRowSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Litterboxd.Supporting"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:layout_width="@dimen/settings_icon_size"
        android:layout_height="@dimen/settings_icon_size"
        android:importantForAccessibility="no"
        app:srcCompat="@drawable/ic_chevron_right"
        app:tint="@color/text_dark_gray" />
</LinearLayout>
