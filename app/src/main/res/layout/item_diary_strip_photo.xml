<?xml version="1.0" encoding="utf-8"?>
<!-- One photo in the diary's "Recent snaps" strip; size and margin are set in DiaryActivity. -->
<com.google.android.material.imageview.ShapeableImageView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/diary_strip_photo_size"
    android:layout_height="@dimen/diary_strip_photo_size"
    android:background="@color/pastel_sage"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/avatar_stroke"
    android:scaleType="centerCrop"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.Litterboxd.DiaryPhoto"
    app:strokeColor="@color/ink"
    app:strokeWidth="@dimen/avatar_stroke" />
