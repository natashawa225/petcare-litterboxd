<?xml version="1.0" encoding="utf-8"?>
<!-- One photo in the Memories collage (MemoriesPhotoAdapter): the image's own aspect ratio gives
     the staggered grid its scrapbook feel, so only the width is fixed by the grid column. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_small"
    app:cardCornerRadius="@dimen/diary_photo_corner">

    <ImageView
        android:id="@+id/imgMemoryPhoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />
</com.google.android.material.card.MaterialCardView>
