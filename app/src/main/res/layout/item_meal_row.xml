<?xml version="1.0" encoding="utf-8"?>
<!-- One meal on the feeding-schedule screen. Defined in XML (not built in Java) so the
     TextInputLayouts get their themed style: the floating hint sits above the text and each
     field has a single underline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/spacing_small"
    android:paddingBottom="@dimen/spacing_medium">

    <TextView
        android:id="@+id/tvMealHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/sage_primary"
        android:textSize="@dimen/text_size_body" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilMealLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMealLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_meal_label"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMealTime"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_small"
        android:textColor="@color/dark_olive_green"
        app:strokeColor="@color/sage_primary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilMealPortion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        app:errorEnabled="true">

        <!-- Digits include both "." and "," (Validators.parseDecimal accepts either). -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMealPortion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="@string/decimal_digits"
            android:hint="@string/meal_portion_prefix"
            android:inputType="numberDecimal"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
