<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Litterboxd" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/sage_primary</item>
        <item name="colorPrimaryVariant">@color/sage_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/coral_secondary</item>
        <item name="colorSecondaryVariant">@color/coral_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background and surface -->
        <item name="android:windowBackground">@color/off_white_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_dark_gray</item>
        <item name="colorError">@color/error_red</item>
        <item name="materialCardViewStyle">@style/Widget.Litterboxd.Card</item>
        <item name="materialButtonStyle">@style/Widget.Litterboxd.Button</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Widget.Litterboxd.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/ink</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.Litterboxd.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/ink</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>
</resources>
