<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Litterboxd" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/sage_primary</item>
        <item name="colorPrimaryVariant">@color/sage_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/coral_secondary</item>
        <item name="colorSecondaryVariant">@color/coral_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Background and surface -->
        <item name="android:windowBackground">@color/off_white_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_dark_gray</item>
        <item name="colorError">@color/error_red</item>
        <item name="materialCardViewStyle">@style/Widget.Litterboxd.Card</item>
        <item name="materialButtonStyle">@style/Widget.Litterboxd.Button</item>
        <item name="android:fontFamily">sans</item>
        <!-- Warm status bar with dark icons instead of the MaterialComponents default purple. -->
        <item name="android:statusBarColor">@color/off_white_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.Litterboxd.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/ink</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- Bottom navigation labels: always visible; the selected tab's label is bold as well as darker. -->
    <style name="TextAppearance.Litterboxd.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/bottom_nav_label_size</item>
    </style>

    <style name="TextAppearance.Litterboxd.NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Large serif-ish screen title used at the top of each tab. -->
    <style name="TextAppearance.Litterboxd.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/title_font</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Section heading inside a tab (e.g. "Quick actions"). -->
    <style name="TextAppearance.Litterboxd.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/sage_primary</item>
        <item name="android:textSize">@dimen/text_size_subtitle</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Secondary text under titles. -->
    <style name="TextAppearance.Litterboxd.Supporting" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_dark_gray</item>
        <item name="android:textSize">@dimen/text_size_small</item>
    </style>

    <!-- Circle crop for owner/cat avatars (ShapeableImageView). -->
    <style name="ShapeAppearance.Litterboxd.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Rounded-square photo thumbnails in the diary. -->
    <style name="ShapeAppearance.Litterboxd.DiaryPhoto" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/diary_photo_corner</item>
    </style>

    <!-- Secondary bordered button (white fill) for quick actions and forms. -->
    <style name="Widget.Litterboxd.Button.Secondary">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="iconTint">@color/black</item>
    </style>

    <style name="Widget.Litterboxd.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/ink</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>
</resources>
