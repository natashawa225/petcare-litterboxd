    <!-- Possible reasons on alerts. Each list follows the source cited for that alert. -->
    <string name="health_alert_reasons_heading">Possible reasons</string>
    <string name="health_alert_source">Source: %1$s, %2$s</string>
    <string name="health_alert_read_source">Read source</string>
    <string name="alert_reasons_urinary_urgent">• Bladder inflammation (cystitis)\n• A urine infection or bladder stones\n• A blocked urethra, which is an emergency</string>
    <string name="alert_reasons_thirst">• Kidney disease\n• Diabetes\n• An overactive thyroid</string>
    <string name="alert_reasons_water_rising">• Warmer weather or more dry food\n• Kidney disease or diabetes\n• An overactive thyroid</string>
    <string name="alert_reasons_vomiting">• Eating something harmful or spoiled\n• A gut condition, such as inflammatory bowel disease\n• Internal parasites or a swallowed object</string>
    <string name="alert_reasons_litter_more">• Bladder inflammation (cystitis)\n• A urine infection or bladder stones\n• Stress</string>
    <string name="alert_reasons_hiding">• Illness or pain\n• Stress or anxiety, such as from other cats or loud noises\n• A change at home</string>
    <string name="alert_appetite_less_title">Eating less for three days</string>
    <string name="alert_appetite_less_message">%1$s was logged eating less for three days in a row. International Cat Care advises contacting your vet urgently at this point.</string>
    <string name="alert_reasons_appetite_less">• Dental disease\n• Kidney, liver or intestinal problems\n• Stress or a change of diet</string>
    <string name="alert_water_less_title">Drinking less for three days</string>
    <string name="alert_water_less_message">%1$s was logged drinking less for three days in a row. If you\'re worried %1$s is dehydrated, contact a vet promptly.</string>
    <string name="alert_reasons_water_less">• Eating more wet food, which contains more water\n• Dental problems or feeling unwell\n• Trouble reaching the water, such as conflict with other pets</string>
    <string name="alert_litter_less_title">Fewer litter visits</string>
    <string name="alert_litter_less_message">%1$s was logged with fewer litter visits on at least two of the last three days. If %1$s is struggling to pass urine, contact a vet now, as this can be an emergency.</string>
    <string name="alert_reasons_litter_less">• Constipation\n• Not drinking enough\n• A litter tray the cat dislikes, such as a dirty or noisy one</string>
    <string name="alert_energy_low_title">Low energy on several days</string>
    <string name="alert_energy_low_message">%1$s was logged with low energy on at least two of the last three days. PDSA advises contacting your vet if a cat has been lethargic for more than 24 hours.</string>
    <string name="alert_reasons_energy_low">• A cat bite abscess\n• Kidney disease or diabetes\n• Poisoning</string>
