    <string name="alert_water_rising_title">%1$s has been drinking more</string>
    <string name="alert_water_rising_message">Over the past week, water intake looks higher than usual on several days. Worth keeping an eye on — and reading up if it continues.</string>
    <string name="alert_drink_pee_title">Drinking more and peeing more</string>
    <string name="alert_drink_pee_message">%1$s\'s logs show more drinking and more urination together. This combination is worth checking with a vet.</string>
    <string name="alert_litter_drink_title">More litter visits and more drinking</string>
    <string name="alert_litter_drink_message">%1$s has more litter visits along with drinking more. This combination is worth checking with a vet.</string>
    <string name="alert_appetite_vomit_title">Eating less and vomiting</string>
    <string name="alert_appetite_vomit_message">%1$s has been eating less, with repeated vomiting logged. This is worth checking with a vet.</string>
    <string name="alert_hiding_title">Hiding for a week or more</string>
    <string name="alert_hiding_message">%1$s has been hiding more for a week or longer. If this is unusual for them, consider checking with a vet.</string>
    <string name="alert_urine_blockage_title">Possible urinary blockage</string>
    <string name="alert_urine_blockage_message">%1$s was logged with straining or little/no urine. This can be an emergency — especially in male cats. Contact a vet now. Litterboxd does not diagnose.</string>
    <string name="alert_drink_pee_weight_title">Drinking more, peeing more, and weight down</string>
    <string name="alert_drink_pee_weight_message">%1$s\'s recent logs show more drinking and urination, and weight has dropped. This combination is worth checking with a vet.</string>
    <string name="alert_litter_baseline_title">Litter visits above %1$s\'s usual</string>
    <string name="alert_litter_baseline_message">Compared with %1$s\'s own earlier logs, “more litter visits” showed up about twice as often this week. Worth watching — not a diagnosis.</string>
    <string name="article_obstruction_title">Urethral obstruction in cats</string>
    <string name="article_obstruction_summary">A blocked bladder is life-threatening and almost always affects male cats. Straining with little or no urine needs urgent veterinary care — do not wait to “see if it passes.”</string>
    <string name="article_flutd_title">Feline lower urinary tract disease</string>
    <string name="article_flutd_summary">FLUTD covers several bladder/urethra problems. Cats may strain, visit the litter often, or pass little urine. Complete blockage is an absolute emergency.</string>

